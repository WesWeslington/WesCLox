class c1{ init(i1, i2){ this.i1 = i1; this.i2 = i2;} f(){ print "initializer 1 = " + this.i1 + " initializer 2 = " + this.i2; } } var C1 = c1("fizz", "buzz"); C1.f();
class c3{ init(i1, i2){ this.i1 = i1; this.i2 = i2;} f(){ print "We can call the method still"; } } var C3 = c3("1", "2"); C3.f(); 
class n{ m(){ fun function() { print "Aint nothin but a thing"; } function(); } } var N = n(); N.m();
class s{ t(first, second){ print "First " + first + " Second " + second; } } var S = s(); S.t("firsty", "secondy");
